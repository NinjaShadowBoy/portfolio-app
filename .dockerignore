# Keep the build context small - node_modules alone is hundreds of MB and is
# reinstalled inside the image anyway.
.git
.github
node_modules
dist
.angular
coverage

# Generated by `pnpm content:build` inside the image; shipping a stale copy in
# would mask content changes.
src/generated

# Local tooling / editor state that never affects the build.
.vscode
.opencode
opencode.json
*.log
.DS_Store

# Docs and audits - not build inputs.
docs
specs
README.md
AGENTS.md
CLAUDE.md
structure-audit.txt
lighthouserc.json
