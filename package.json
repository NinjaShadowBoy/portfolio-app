{
  "name": "portfolio-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "bun run content:build && ng serve",
    "content:build": "bun scripts/build-content.mjs",
    "// ng:build": "ng itself runs on node via its shebang (SSR route extraction fails under the bun runtime). NODE_OPTIONS preloads scripts/fs-cp-retry.cjs, which retries the asset copy that intermittently fails with EPERM/utime on Windows and aborts the build half-written. No-op on other platforms. Extra args (e.g. --configuration=staging) are appended by bun.",
    "ng:build": "NODE_OPTIONS='--require ./scripts/fs-cp-retry.cjs' ng build",
    "build": "bun run content:build && bun run ng:build",
    "build:staging": "bun run build --configuration=staging",
    "build:gh-pages": "bun run build --configuration gh-pages --base-href / --deploy-url /",
    "watch": "bun run build --watch --configuration development",
    "serve": "node dist/portfolio-app/server/server.mjs",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:content": "bun test scripts/build-content.spec.mjs",
    "test:fs-cp-retry": "bun test scripts/fs-cp-retry.spec.mjs",
    "docker:build": "docker build -t portfolio-app .",
    "docker:run": "docker run --rm -p 4000:4000 portfolio-app",
    "deploy": "bun run build:gh-pages && bunx angular-cli-ghpages --dir=dist/portfolio-app/browser"
  },
  "private": true,
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "lmdb",
    "msgpackr-extract"
  ],
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/ssr": "^22.1.7",
    "cloudinary": "^2.8.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/localize": "^22.1.5",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.19",
    "baseline-browser-mapping": "^2.10.37",
    "gray-matter": "^4.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "shiki": "^4.3.1",
    "typescript": "~6.0.3"
  }
}
