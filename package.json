{
  "name": "portfolio-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh-pages": "ng build --configuration gh-pages --base-href / --deploy-url /",
    "deploy": "bun run build:gh-pages && bunx angular-cli-ghpages --dir=dist/portfolio-app/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:fs-cp-retry": "node --test scripts/fs-cp-retry.spec.mjs",
    "serve": "node dist/portfolio-app/server/server.mjs"
  },
  "private": true,
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "lmdb",
    "msgpackr-extract"
  ],
  "dependencies": {
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/platform-server": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/ssr": "^22.0.1",
    "cloudinary": "^2.8.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@angular/localize": "^22.0.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.19",
    "baseline-browser-mapping": "^2.10.37",
    "gray-matter": "^4.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "shiki": "^4.3.1",
    "typescript": "~6.0.3"
  }
}
