{
  "name": "portfolio-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "bun run content:build && ng serve",
    "content:build": "bun scripts/build-content.mjs",
    "// ng:build": "ng itself runs on node via its shebang (SSR route extraction fails under the bun runtime). NODE_OPTIONS preloads scripts/fs-cp-retry.cjs, which retries the asset copy that intermittently fails with EPERM/utime on Windows and aborts the build half-written. No-op on other platforms. Extra args (e.g. --configuration=staging) are appended by bun.",
    "ng:build": "NODE_OPTIONS='--require ./scripts/fs-cp-retry.cjs' ng build",
    "build": "bun run content:build && bun run ng:build",
    "build:staging": "bun run build --configuration=staging",
    "watch": "bun run build --watch --configuration development",
    "serve": "node dist/portfolio-app/server/server.mjs",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:content": "bun test scripts/build-content.spec.mjs",
    "test:fs-cp-retry": "bun test scripts/fs-cp-retry.spec.mjs",
    "docker:build": "docker build -t portfolio-app .",
    "docker:run": "docker run --rm -p 4000:4000 portfolio-app"
  },
  "private": true,
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "lmdb",
    "msgpackr-extract"
  ],
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "express": "^5.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/localize": "^22.2.4",
    "@types/express": "^5.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24",
    "baseline-browser-mapping": "^2.11.35",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.3",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "shiki": "^4.6.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
